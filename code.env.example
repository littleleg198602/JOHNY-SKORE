# Copy this file to code.env and keep the real key only on your computer.
ALPHAVANTAGE_API_KEY=replace_with_a_new_key
# Scout runner does not load code.env. Set these as Windows User environment
# variables for the scheduled scout task; values here are only examples.
# Optional FRED macro observations (get a personal key from FRED).
JOHNY_SKORE_FRED_API_KEY=
# Optional EIA daily energy prices (requires a personal EIA API key).
JOHNY_SKORE_EIA_API_KEY=
