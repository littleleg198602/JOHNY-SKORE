<script>

document.addEventListener("DOMContentLoaded", function(){
  const title = document.getElementById("productTitle");
  if(!title) return;

  const names = [...new Set(
    [...document.querySelectorAll(".grid-row:not(.grid-header) div:nth-child(7)")]
    .map(e1 => e1.textContent.trim())
    .filter(Boolean)
  )];
  title.textContent = names.join(", ");
})
</script>
        
    

    

