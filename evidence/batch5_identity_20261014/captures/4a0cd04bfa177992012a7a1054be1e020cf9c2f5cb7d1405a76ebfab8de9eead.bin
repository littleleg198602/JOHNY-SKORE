<td style="vertical-align:top">By:</td>
<td style="vertical-align:bottom">&#160;</td>
<td style="vertical-align:bottom"> <p style="margin-top:0pt; margin-bottom:1pt; border-bottom:1px solid #000000; font-size:10pt; font-family:Times New Roman">/s/ Susan E. Buchanan</p></td></tr>
