id #949292;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Proxima Nova Lt',sans-serif;font-size:9pt;font-weight:400;line-height:120%">60</span></td><td colspan="3" style="border-top:0.5pt solid #949292;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Proxima Nova Lt',sans-serif;font-size:9pt;font-weight:400;line-height:120%">Yes</span></td><td colspan="3" style="border-top:0.5pt solid #949292;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Proxima Nova Lt',sans-serif;font-size:9pt;font-weight:400;line-height:120%">2020</span></td><td colspan="3" style="border-top:0.5pt solid #949292;padding:2px 1pt;text-align:left;vertical-align:middle"><div style="margin-top:4pt;text-align:center"><img src="pstg-20260430_g24.jpg" alt="02 426282-1_Icon_Board-Committees-02.jpg" style="height:14px;margin-bottom:5pt;vertical-align:text-bottom;width:14px" id="i-46"/><span style="color:#000000;font-family:'Proxima Nova Lt',sans-serif;font-size:1pt;font-weight:400;line-height:120%">&#160;</span></div></td><td colspan="3" style="border-top:0.5pt solid #949292;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #949292;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #949292;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #949292;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Proxima Nova Lt',sans-serif;font-size:9pt;font-weight:400;line-height:120%">-</span></td></tr><tr><td colspan="3" style="border-bottom:1pt solid #ff7023;border-top:0.5pt solid #949292;padding:2px 1pt;text-align:left;vertical-align:top"><div style="padding-right:4.5pt"><span style="color:#ff7024;font-family:'Proxima Nova Cn Rg',sans-serif;font-size:9pt;font-weight:700;line-height:115%">Mallun Yen</span></div><div><span style="color:#000000;font-family:'Proxima Nova Cn Rg',sans-serif;font-si